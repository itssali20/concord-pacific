# Optional: form endpoint (e.g. Formspree https://formspree.io/f/xxxx). If empty, the form opens the visitor's email client.
VITE_FORM_ENDPOINT=
VITE_CONTACT_EMAIL=inquiries@concordpacificcorp.com
VITE_CONTACT_PHONE=800-201-0145

# SEO — the live website address (no trailing slash). Change when moving to the company domain, then redeploy.
VITE_SITE_URL=https://concord-pacific-final.vercel.app
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GA_ID=
# Google Search Console HTML-tag verification code (only the content="..." value). Not needed if verified by DNS.
VITE_GSC_VERIFICATION=
# Bing Webmaster Tools verification code (msvalidate.01 content value). Optional.
VITE_BING_VERIFICATION=
